# ============================================================================
# FXR sales-leads — environment variables
# Copy the keys into Render → your service → Environment. Do NOT commit real
# values. Everything here has a safe default except the Twilio + SMTP creds.
# ============================================================================

# Public base URL of this API (used to build the PDF MediaUrl for Twilio).
PUBLIC_BASE_URL=https://fxrcon-construction.onrender.com

# Where the WhatsApp PDF is delivered (Guild forwarding number).
WHATSAPP_TO=+19038903834

# New-lead email notifications land here.
NOTIFY_EMAIL=info@fxrcon.com

# Optional: point at a Render persistent disk to survive restarts (default ./data).
# DATA_DIR=/var/data

# ---- Twilio (texting to Guild + WhatsApp PDF) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Guild bid-request text (fires on each new lead) ----
# Where Guild's bid request goes.
GUILD_TO=+19038903834
# 'mms' = picture text to Guild's phone (recommended, no WhatsApp approval).
# 'whatsapp' = deliver inside WhatsApp (needs an approved Twilio WhatsApp sender + template).
GUILD_CHANNEL=mms
# Your Twilio sending number. For MMS: a US number like +1XXXXXXXXXX.
# For WhatsApp: your approved sender, e.g. whatsapp:+14155238886.
TWILIO_FROM=

# ---- WhatsApp PDF (only for the dashboard "Generate PDF & Send" button) ----
# Sandbox: whatsapp:+14155238886 . Production: your approved WhatsApp sender.
TWILIO_WHATSAPP_FROM=

# ---- SMTP for email notifications (leave blank to disable email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FXR Sales <info@fxrcon.com>
