# ============================================================================
# FXR sales-leads — environment variables
# Copy the keys into Render → your service → Environment. Do NOT commit real
# values.
#
# CURRENT FLOW: on Send, each lead is pushed into JobTread (CRM) with photos
# attached, and an email notification goes out. For the JobTread push, only
# JT_GRANT_KEY is required.
# ============================================================================

# ---- JobTread: push the lead into the CRM on Send (REQUIRED for JT push) ----
# Create a grant/API key in JobTread (Settings -> Integrations / API) and
# ENABLE these actions on the grant: createCustomer, createUploadRequest,
# createFile, createComment. Paste the grant key (starts with "grant_") here.
JT_GRANT_KEY=
# FXR organization id (already known; only change if it differs).
JT_ORG_ID=22PKKRUxRtz8

# Where the lead PDF report is emailed.
NOTIFY_EMAIL=jesus@fxrcon.com

# ---- SMTP: how the report email is sent (REQUIRED for the email to go out) ----
# For a Google Workspace / Gmail address, use an App Password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=jesus@fxrcon.com  SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FXR Sales <jesus@fxrcon.com>

# Optional: point at a Render persistent disk to survive restarts (default ./data).
# DATA_DIR=/var/data

# ============================================================================
# OPTIONAL — automated text to Guild (OFF by default; Jesus forwards manually)
# ============================================================================
# 'none' (default) = don't auto-text; 'ringcentral' or 'twilio' to enable later.
GUILD_PROVIDER=none
# Where Guild's bid request goes if auto-texting is turned on.
GUILD_TO=+19038903834

# ---- RingCentral (recommended: sends from the FXR office line) ----
# Create an app at developers.ringcentral.com with the "SMS" permission, then
# generate a JWT credential for it. Paste the values here.
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
# The FXR office RingCentral number the text is sent FROM (must be SMS-enabled).
RC_FROM=+14087699928
# Production platform. Sandbox testing: https://platform.devtest.ringcentral.com
RC_SERVER_URL=https://platform.ringcentral.com

# ---- Twilio (only if GUILD_PROVIDER=twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# 'mms' = picture text to Guild's phone. 'whatsapp' = inside WhatsApp (needs approval).
GUILD_CHANNEL=mms

# ---- WhatsApp PDF (only for the dashboard "Generate PDF & Send" button) ----
PUBLIC_BASE_URL=https://fxrcon-construction.onrender.com
WHATSAPP_TO=+19038903834
# Sandbox: whatsapp:+14155238886 . Production: your approved WhatsApp sender.
TWILIO_WHATSAPP_FROM=
