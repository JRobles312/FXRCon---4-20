# Zeus 3.0 pipeline configuration.
# Copy to `.env` and fill in real values (never commit the real .env).

# OpenAI API key. If unset, the pipeline runs with templated fallback replies.
OPENAI_API_KEY=

# LLM model used by the AI agents.
ZEUS_MODEL=gpt-4o-mini

# Customer-facing review link and referral reward.
ZEUS_GOOGLE_REVIEW_LINK=https://g.page/r/your-review-link
ZEUS_REFERRAL_REWARD=$50

# Port for the Flask server.
PORT=5000
